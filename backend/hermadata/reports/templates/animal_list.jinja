{% extends "base.jinja" %}
{% block styles %}
<style>
    @page {
        size: A4 landscape;
        margin: 1.5cm 1.5cm 2cm 1.5cm;
    }
    .animal-list-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    .animal-list-table th,
    .animal-list-table td {
        border: 1px solid #000;
        padding: 4px 8px;
        text-align: left;
    }
    .animal-list-table thead th {
        background-color: #f0f0f0;
        font-weight: bold;
    }
</style>
{% endblock %}
{% block content %}
<table class="animal-list-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Nome</th>
            <th>Chip</th>
            <th>Provenienza</th>
            <th>Sesso</th>
        </tr>
    </thead>
    <tbody>
        {% for item in items %}
        <tr>
            <td>{{ loop.index }}</td>
            <td>{{ item.name or '' }}</td>
            <td>{{ item.chip_code or '' }}</td>
            <td>{{ item.origin_city }}</td>
            <td>{{ item.sex or '' }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
<p style="margin-top: 1rem; font-size: 0.875rem; font-weight: bold;">Totale: {{ total }}</p>
{% endblock %}
